NODE_ENV=development
PORT=5000
CLIENT_URL=http://127.0.0.1:3000
SERVER_URL=http://127.0.0.1:5000
MONGO_URI=mongodb://127.0.0.1:27017/sarafupay
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=sarafupay_token

# ---------------------------------------------------------------------------
# Snippe payment gateway
# REQUIRED in production — server will not start without these.
# Optional in development (payment creation will fail gracefully with 503).
# ---------------------------------------------------------------------------
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_PROFILE_ID=

# ---------------------------------------------------------------------------
# Google OAuth (optional — Google login is disabled if these are absent)
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET come from Google Cloud Console.
# GOOGLE_CALLBACK_URL must be registered as an Authorized redirect URI there.
# It must go through the Vercel proxy (frontend URL), not the backend URL directly.
#   Development:  http://localhost:3000/api/auth/google/callback
#   Production:   https://sarafupay.app/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Seed admin account (used by the seed script only, not runtime-required)
# ---------------------------------------------------------------------------
ADMIN_NAME=SarafuPay Admin
ADMIN_EMAIL=admin@sarafupay.test
ADMIN_PHONE=+255700000000
ADMIN_PASSWORD=ChangeMe123!
