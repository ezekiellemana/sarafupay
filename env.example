# ---- App ----
APP_URL=http://localhost:3000            # public URL, e.g. https://sarafupay.app
# DATABASE_URL=postgres://...            # Postgres. Leave empty locally -> embedded PGlite in ./.data
ENABLE_SIMULATOR=true                     # web chat at /chat
# REDIS_URL=redis://...                  # optional; empty -> in-memory AI cost guard
DAILY_AI_LIMIT=300                        # max AI calls per UTC day across all users
CRON_SECRET=                              # shared by the web service and the reconcile job
ADMIN_KEY=                                # owner-only admin page: /admin?key=<ADMIN_KEY>

# ---- Snippe (mobile money, TZS) — dashboard: snippe.sh ----
SNIPPE_API_KEY=                           # snp_...
SNIPPE_WEBHOOK_SECRET=                    # whsec_... (Settings > Webhook Secret)
SNIPPE_PROFILE_ID=                        # optional: payment profile for checkout branding
# SNIPPE_BASE_URL=https://api.snippe.sh

# ---- PayPal (card / PayPal, USD) — developer.paypal.com > Apps & Credentials ----
PAYPAL_ENV=sandbox                        # "live" for real money
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=                        # after creating the webhook to $APP_URL/api/paypal/webhook
SANDBOX_BUYER_EMAIL=                      # optional, test mode only: shown in the simulator
SANDBOX_BUYER_PASSWORD=
SANDBOX_PAYEE_EMAIL=

# ---- Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=                    # any random string; paste the same in Meta webhook config
WHATSAPP_APP_SECRET=                      # Meta app secret, for X-Hub-Signature-256 verification
WHATSAPP_DISPLAY_NUMBER=                  # bot number in international format, e.g. 255650972587
# WHATSAPP_REMINDER_TEMPLATE=pledge_reminder

# ---- AG Studio (treasurer dashboard) ----
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
