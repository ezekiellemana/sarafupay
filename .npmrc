# Ensure devDependencies are always installed during npm install.
# Required for DigitalOcean App Platform: NODE_ENV=production is set in the
# build environment, which causes npm to skip devDependencies by default.
# TypeScript compilation (tsc) needs @types/* packages from devDependencies.
# This setting has no effect at runtime — it only applies during npm install.
#
# Note: npm 10+ shows a deprecation warning ("Use --omit=dev instead") but
# continues to honour this setting. The warning is cosmetic and does not
# affect the build outcome.
production=false
